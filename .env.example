# Generate a token with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
HACKRF_BRIDGE_TOKEN=
# Bind to the USB host's LAN IP when HA runs on another machine.
HACKRF_BRIDGE_BIND=127.0.0.1
# Find the HackRF with lsusb; use its bus and device numbers.
HACKRF_USB_DEVICE=/dev/bus/usb/001/005
