# Generate a token with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
HACKRF_BRIDGE_TOKEN=
# Optional separate receive-only token for scripts and third-party programs.
HACKRF_RECEIVE_TOKEN=
# Bind to the USB host's LAN IP when HA runs on another machine.
HACKRF_BRIDGE_BIND=127.0.0.1
# Find the HackRF with lsusb; use its bus and device numbers.
HACKRF_USB_DEVICE=/dev/bus/usb/001/005
# Optional compose.tools.yaml build profile (reviewed catalog IDs only).
HACKRF_APPS=soapy_remote,inspectrum

# Non-root programs: scripts/setup_bridge.py --programs generates the required
# HACKRF_UID, HACKRF_GID, HACKRF_USB_GID, HACKRF_DATA_DIR and HACKRF_PROGRAMS_DIR.
# Do not regenerate tokens or replace persistent state during an upgrade.
